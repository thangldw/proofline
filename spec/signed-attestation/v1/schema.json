{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thangldw/proofline/spec/signed-attestation/v1/schema.json",
  "title": "Proofline Signed Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithm", "key_id", "statement", "signature"],
  "properties": {
    "schema": {"const": "proofline-signed-attestation-v1"},
    "algorithm": {"const": "ed25519"},
    "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "issued_at", "package", "review_receipt"],
      "properties": {
        "schema": {"const": "proofline-attestation-statement-v1"},
        "issued_at": {"type": "string", "format": "date-time"},
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_hash", "artifact_id"],
          "properties": {
            "root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "artifact_id": {"type": "string", "format": "uuid"}
          }
        },
        "review_receipt": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["receipt_hash", "review_id", "dep_root_hash"],
              "properties": {
                "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "review_id": {"type": "string", "format": "uuid"},
                "dep_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        }
      }
    },
    "signature": {"type": "string", "contentEncoding": "base64"}
  }
}
